# URL base del proyecto en Supabase ("link bd"), sin /rest/v1 al final.
# Ejemplo: https://abcd1234xyz.supabase.co
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave privada de backend (service_role). NO subir la real a GitHub.
# Supabase > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Secreto para firmar JWT en desarrollo. Usar un valor largo y privado.
JWT_SECRET=una_clave_secreta_segura_para_desarrollo

# Puerto local del backend.
PORT=4000
