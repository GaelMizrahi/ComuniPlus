# URL del proyecto en Supabase ("link bd")
# Usá la URL base del proyecto, SIN /rest/v1 al final.
# Ejemplo correcto: https://abcd1234xyz.supabase.co
SUPABASE_URL=""

# Clave de backend con permisos altos (service_role key)
# Se obtiene en Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=""

# Puerto local del backend (opcional)
PORT=4000
